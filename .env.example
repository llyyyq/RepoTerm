# =============================================================================
# RepoTerm - environment variable template
# =============================================================================
# Copy to `.env` only as a local template. Load these variables into your shell,
# IDE, or `~/.repoterm/settings.json`; never commit the real `.env` file.
# At minimum, configure one model and one matching credential.
# =============================================================================

# --- Primary Anthropic or Anthropic-compatible channel ---
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=

# RepoTerm also accepts REPOTERM_MODEL as an explicit model override.
# REPOTERM_MODEL=claude-sonnet-4-20250514

# --- Optional OpenAI fallback ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_MODEL_FALLBACKS=gpt-4o,gpt-4o-mini

# --- Optional OpenRouter fallback ---
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api
# OPENROUTER_MODEL_FALLBACKS=openrouter/auto
# OPENROUTER_REFERER=https://github.com/<your-account>/RepoTerm
# OPENROUTER_TITLE=RepoTerm

# --- Optional custom OpenAI-compatible endpoint ---
# CUSTOM_API_KEY=
# CUSTOM_API_BASE_URL=http://localhost:11434/v1
# CUSTOM_MODEL_FALLBACKS=my-local-model
# CUSTOM_API_EXTRA_HEADERS=X-Custom-Header:value

# --- Generic fallback order (comma-separated model ids) ---
# REPOTERM_MODEL_FALLBACKS=gpt-4o-mini,openrouter/auto

# --- Runtime behavior ---
REPOTERM_RUNTIME_PROFILE=single
REPOTERM_TOOL_PROFILE=core
REPOTERM_LOG_LEVEL=WARNING
# REPOTERM_LOG_STRUCTURED=false
# REPOTERM_LANGUAGE=zh-CN
# REPOTERM_VERBOSITY=normal
# REPOTERM_MAX_OUTPUT_TOKENS=8192
# REPOTERM_MODEL_TIMEOUT=120
# REPOTERM_TOOL_TIMEOUT=120
# REPOTERM_MAX_RETRIES=3

# Chinese Windows legacy command output can use cp936 or gbk.
# REPOTERM_COMMAND_ENCODING=cp936

# Project-level MCP configuration is disabled by default for safety.
# REPOTERM_TRUST_PROJECT_MCP=0
